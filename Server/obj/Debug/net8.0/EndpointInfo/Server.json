{
  "openapi": "3.0.1",
  "info": {
    "title": "Server",
    "version": "1.0"
  },
  "paths": {
    "/api/image/upload": {
      "post": {
        "tags": [
          "Image"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadImageRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadImageRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UploadImageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UploadImageResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadImageResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/image/process": {
      "post": {
        "tags": [
          "Image"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyFiltersRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyFiltersRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyFiltersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyFiltersResponseApiResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyFiltersResponseApiResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyFiltersResponseApiResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplyFiltersRequest": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "imageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "filters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterAction"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApplyFiltersResponse": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "totalProcessingTimeMs": {
            "type": "integer",
            "format": "int64"
          },
          "filterTimings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterTimingDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApplyFiltersResponseApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/ApplyFiltersResponse"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FilterAction": {
        "type": "object",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/FilterType"
          },
          "intensity": {
            "type": "integer",
            "format": "int32"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": { },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "FilterTimingDto": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "string",
            "nullable": true
          },
          "durationMs": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "FilterType": {
        "enum": [
          "Invert",
          "Brightness",
          "EdgeEnhance",
          "EmbossLaplacian",
          "Pixelate",
          "TimeWarp",
          "JjnDithering",
          "Colorize"
        ],
        "type": "string"
      },
      "UploadImageRequest": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "format": "byte",
            "nullable": true
          },
          "fileName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UploadImageResponse": {
        "type": "object",
        "properties": {
          "imageId": {
            "type": "string",
            "format": "uuid"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "width": {
            "type": "integer",
            "format": "int32"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}